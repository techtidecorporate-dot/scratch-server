PORT=5000
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
OPENAI_API_KEY=your_openai_api_key
RESEND_API_KEY=your_resend_api_key
JWT_SECRET=your_super_secret_key
APOLLO_API_KEY=your_apollo_api_key
SCRAPE_MAX_LEADS=5

# --- PRODUCTION (server / VPS only) ---
NODE_ENV=development
# Absolute path to a system-installed Chromium/Chrome on the production server.
# Leave UNSET locally so Puppeteer uses its bundled Chromium.
# Debian/Ubuntu VPS examples: /usr/bin/chromium  |  /usr/bin/chromium-browser  |  /usr/bin/google-chrome
PUPPETEER_EXECUTABLE_PATH=
